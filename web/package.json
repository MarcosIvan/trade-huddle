{
  "name": "trade-huddle-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp.mjs out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backtest": "vitest run --config scripts/backtest/vitest.config.ts --reporter=dot backtest.run",
    "backtest:scarcity": "vitest run --config scripts/backtest/vitest.config.ts --reporter=dot scarcity.run",
    "backtest:teammates": "vitest run --config scripts/backtest/vitest.config.ts --reporter=dot teammates.run",
    "backtest:weekly": "vitest run --config scripts/backtest/vitest.config.ts --reporter=dot weekly.run"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
